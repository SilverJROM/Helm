+  const candidateLabel =
+    `final-candidate path=${input.candidatePath} sha12=${input.candidateShort12 ?? 'unreadable'}`;
+  const otherLabel =
+    `${input.otherLabel} path=${input.otherPath} sha12=${input.otherShort12 ?? 'unreadable'}`;
