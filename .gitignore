data/swaps/

# internal planning artifacts (projcore/lead run state — do not leak).
# NOTE: plan-cache/ is product data (referenced by src/), keep it tracked.
plan/
# north-star.md is now TRACKED (JROM 2026-07-26). It is the PROJECT constitution, not run state:
# no secrets, and it is what a future contributor — or JROM on another machine — needs. `plan/`
# stays ignored because that IS per-run scaffolding.

# [north] 2026-07-26 — pre-git backup litter. These 229 sibling copies existed ONLY because
# the tree had no git; they stay on disk, they just aren't tracked. Superseded by real history.
*.bak-*
.pre-cyclebuilddir-backup/

# [north] 2026-07-26 — two pattern gaps found while taking the first baseline:
#   `node_modules/` (trailing slash) cannot match node_modules when it is a SYMLINK, which it is
#   here (-> TGBOTS/Helm-ovm-run/node_modules). A committed symlink breaks any fresh clone.
node_modules
#   `data/*.db*` only matches DIRECT children of data/, so data/backups/*.db* was slipping through.
data/backups/
data/**/*.db*
# B1 (R2.12/F6): durable HELM_RUN_ROOT — per-run scaffolding (briefs, callbacks.md, evidence), same
# runtime-artifact class as data/*.db* above; never tracked.
data/runs/
